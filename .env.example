# ═══════════════════════════════════════════════════════════════
# DNS Zone Manager — Environment Configuration Template
#
# Usage:
#   1) cp .env.example .env
#   2) Fill in real values below
#   3) NEVER commit .env (it's git-ignored)
#
# Generate a strong JWT secret:
#   openssl rand -hex 32
#
# Generate a self-signed cert (optional):
#   ./generate-certs.sh <your-domain-or-ip>
# ═══════════════════════════════════════════════════════════════

# ── Database Mode ──
# Lite: SQLite (single container, no Postgres required) — recommended for small/medium teams
# Full: external PostgreSQL — recommended for HA / large deployments
USE_SQLITE=true
SQLITE_DB_PATH=backend/dns_manager.db

# ── Web Ports ──
HTTP_PORT=80
HTTPS_PORT=443

# ── JWT Authentication ──
# IMPORTANT: replace with a strong random secret in production (>= 32 bytes hex)
JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── PostgreSQL (only used when USE_SQLITE=false) ──
POSTGRES_USER=dns_admin
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=dns_manager
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── F5 BIG-IP Connection ──
# Primary F5 device used during init; more can be added via UI
F5_ACTIVE_HOST=192.0.2.10
F5_SSH_PORT=22
F5_SSH_USER=root

# Authentication: use password OR SSH key (SSH key strongly recommended)
# Local dev:  ./ssh_keys/id_ed25519
# Docker:     /app/keys/id_ed25519
F5_SSH_PASSWORD=
F5_SSH_KEY_PATH=./ssh_keys/id_ed25519
F5_SSH_KEY_PASSPHRASE=

# BIND paths on F5 (real filesystem; named runs in chroot -t /var/named)
# Adjust if your F5 uses non-standard paths
F5_NAMED_CONF=/var/named/config/named.conf
F5_ZONE_DIR=/var/named/config/namedb

# ── App ──
DEBUG=false